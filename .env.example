# Copy to .env and fill in. Placeholders only: never commit a real token.

# muster's address: https://, or http:// to localhost / 127.0.0.1 / [::1] only.
MUSTER_URL=https://muster.example.com

# The plugin token (mpl_…), shown once when you create the plugin on muster's
# /plugins page. It opens muster's /plugin/v1/* routes only, acting as you.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# How often the fake upstream produces a message (a Go duration, at least 1s).
ECHO_INTERVAL=30s

# Where the sent-drafts journal and the upstream cursor live. Keep it across
# restarts: it is what stops a draft being sent twice, and a message being
# skipped or posted again.
STATE_DIR=./state
